# Copy to .env and fill in real values. docker-compose.yaml falls back to the
# defaults shown here for local development.
POSTGRES_PASSWORD=password
MONGO_PASSWORD=password
KEYCLOAK_ADMIN_PASSWORD=admin

# Used by the services through application-dev.yaml (not committed):
GMAIL_APP_PASSWORD=your_gmail_app_password
CURRENCY_API_KEY=your_api_key
